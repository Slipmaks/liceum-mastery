    {
      "name": "Primary Button (student)",
      "kind": "button",
      "refersTo": "button-primary-student",
      "description": "The one forward action per view, 48px on the student screen.",
      "html": "<button class=\"ds-btn-primary\">Далі →</button>",
      "css": ".ds-btn-primary{height:48px;padding:0 16px;border:1px solid transparent;border-radius:calc(var(--radius,0.5rem)*0.8);background:var(--primary,oklch(0.45 0.17 263));color:var(--primary-foreground,oklch(0.99 0.003 250));font:500 16px/1 Inter,sans-serif}.ds-btn-primary:hover{background:color-mix(in oklch,var(--primary,oklch(0.45 0.17 263)) 80%,transparent)}.ds-btn-primary:focus-visible{outline:none;box-shadow:0 0 0 3px color-mix(in oklch,var(--ring,oklch(0.55 0.15 263)) 50%,transparent)}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Secondary actions: «Назад», «Закрити тест», «Завершити тест».",
      "html": "<button class=\"ds-btn-outline\">← Назад</button>",
      "css": ".ds-btn-outline{height:48px;padding:0 16px;border:1px solid var(--border,oklch(0.9 0.008 255));border-radius:calc(var(--radius,0.5rem)*0.8);background:var(--background,oklch(0.99 0.003 250));color:var(--foreground,oklch(0.22 0.015 260));box-shadow:0 1px 2px rgb(0 0 0/5%);font:500 16px/1 Inter,sans-serif}.ds-btn-outline:hover{background:var(--muted,oklch(0.96 0.006 255))}.ds-btn-outline:focus-visible{outline:none;box-shadow:0 0 0 3px color-mix(in oklch,var(--ring,oklch(0.55 0.15 263)) 50%,transparent)}"
    },
    {
      "name": "Answer-sheet Strip",
      "kind": "custom",
      "refersTo": "sheet-cell",
      "description": "Signature: numbered cells (28px tall in the student header), inked when answered, current one outlined. Same cell at 10x14 unnumbered in the teacher table, followed by n/12.",
      "html": "<div class=\"ds-strip\"><span class=\"ds-cell on\">1</span><span class=\"ds-cell on\">2</span><span class=\"ds-cell on\">3</span><span class=\"ds-cell cur\">4</span><span class=\"ds-cell\">5</span><span class=\"ds-cell\">6</span></div>",
      "css": ".ds-strip{display:flex;gap:4px;width:280px}.ds-cell{flex:1;height:28px;display:grid;place-items:center;border:1px solid var(--input,oklch(0.86 0.01 255));border-radius:2px;background:var(--sheet,oklch(0.975 0.006 255));color:color-mix(in oklch,var(--foreground,oklch(0.22 0.015 260)) 75%,transparent);font:600 12px/1 Inter,sans-serif;font-variant-numeric:tabular-nums}.ds-cell.on{border-color:var(--primary,oklch(0.45 0.17 263));background:var(--primary,oklch(0.45 0.17 263));color:var(--primary-foreground,oklch(0.99 0.003 250))}.ds-cell.cur{outline:2px solid var(--primary,oklch(0.45 0.17 263));outline-offset:1px}"
    },
    {
      "name": "Option Row",
      "kind": "custom",
      "refersTo": "choice-row",
      "description": "56px answer option with a lettered mark that fills with ink when chosen.",
      "html": "<label class=\"ds-opt\"><input type=\"radio\" name=\"ds\" checked><span class=\"ds-mark\">А</span><span>1648 рік</span></label>",
      "css": ".ds-opt{display:flex;align-items:center;gap:12px;min-height:56px;padding:10px 12px;border:1px solid var(--border,oklch(0.9 0.008 255));border-radius:var(--radius,0.5rem);background:var(--card,#fff);color:var(--foreground,oklch(0.22 0.015 260));font:400 16px/1.375 Inter,sans-serif;cursor:pointer}.ds-opt input{position:absolute;opacity:0}.ds-mark{display:grid;place-items:center;width:32px;height:32px;border:1px solid var(--input,oklch(0.86 0.01 255));border-radius:4px;background:var(--sheet,oklch(0.975 0.006 255));font-weight:600;font-size:14px}.ds-opt:has(input:checked){border-color:var(--primary,oklch(0.45 0.17 263));background:var(--accent,oklch(0.95 0.025 263))}.ds-opt input:checked+.ds-mark{border-color:var(--primary,oklch(0.45 0.17 263));background:var(--primary,oklch(0.45 0.17 263));color:var(--primary-foreground,oklch(0.99 0.003 250))}.ds-opt:has(input:focus-visible){box-shadow:0 0 0 3px color-mix(in oklch,var(--ring,oklch(0.55 0.15 263)) 50%,transparent)}"
    },
    {
      "name": "Matching Grid Cell",
      "kind": "custom",
      "refersTo": "match-cell",
      "description": "48px square printed cell; the mark is an ink cross.",
      "html": "<div class=\"ds-grid\"><span class=\"ds-mc\"></span><span class=\"ds-mc on\"><svg viewBox=\"0 0 24 24\" width=\"28\" height=\"28\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.75\" stroke-linecap=\"round\"><path d=\"M18 6 6 18M6 6l12 12\"/></svg></span><span class=\"ds-mc\"></span></div>",
      "css": ".ds-grid{display:flex}.ds-mc{display:grid;place-items:center;width:48px;height:48px;border:1px solid var(--input,oklch(0.86 0.01 255));margin-left:-1px;background:var(--sheet,oklch(0.975 0.006 255));color:var(--primary,oklch(0.45 0.17 263))}.ds-mc.on{background:var(--accent,oklch(0.95 0.025 263))}"
    },
    {
      "name": "Timer",
      "kind": "chip",
      "refersTo": "timer",
      "description": "mm:ss, muted at rest, amber under 5 min, red under 1 min.",
      "html": "<span class=\"ds-timer\">23:41</span> <span class=\"ds-timer warn\">04:12</span> <span class=\"ds-timer crit\">00:48</span>",
      "css": ".ds-timer{display:inline-flex;padding:6px 10px;border-radius:calc(var(--radius,0.5rem)*0.8);background:var(--muted,oklch(0.96 0.006 255));color:var(--foreground,oklch(0.22 0.015 260));font:600 16px/1.5 Inter,sans-serif;font-variant-numeric:tabular-nums}.ds-timer.warn{background:var(--warning-soft,oklch(0.965 0.045 85));color:var(--warning-foreground,oklch(0.47 0.11 60))}.ds-timer.crit{background:var(--danger-soft,oklch(0.965 0.025 27));color:var(--destructive,oklch(0.53 0.2 27))}"
    },
    {
      "name": "Status Badges",
      "kind": "chip",
      "refersTo": "status-locked",
      "description": "Locked red, submitted green, writing graphite outline.",
      "html": "<span class=\"ds-badge lock\">Заблоковано</span> <span class=\"ds-badge done\">Здав</span> <span class=\"ds-badge\">Пише</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;height:20px;padding:0 8px;border:1px solid var(--input,oklch(0.86 0.01 255));border-radius:calc(var(--radius,0.5rem)*0.6);font:500 12px/1 Inter,sans-serif;color:var(--foreground,oklch(0.22 0.015 260))}.ds-badge.lock{border-color:transparent;background:var(--destructive,oklch(0.53 0.2 27));color:#fff}.ds-badge.done{border-color:transparent;background:var(--success-soft,oklch(0.965 0.03 150));color:var(--success,oklch(0.5 0.12 150))}"
    },
    {
      "name": "Cheating Flag",
      "kind": "custom",
      "refersTo": "flag-icon",
      "description": "Amber warning-triangle icon before the event text; explained by a legend under the table. Never a badge, never changes row height.",
      "html": "<span class=\"ds-ev\"><span class=\"ds-flag\" role=\"img\" aria-label=\"Можливе списування\" title=\"Можливе списування\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3\"/><path d=\"M12 9v4\"/><path d=\"M12 17h.01\"/></svg></span>Згорнув вкладку · 10:18 (+1)</span>",
      "css": ".ds-ev{display:inline-flex;align-items:center;gap:8px;font:400 14px/1.43 Inter,sans-serif;color:var(--muted-foreground,oklch(0.5 0.02 260));font-variant-numeric:tabular-nums}.ds-flag{display:inline-flex;color:var(--warning-foreground,oklch(0.47 0.11 60))}"
